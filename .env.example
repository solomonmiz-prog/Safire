STRIPE_PUBLISHABLE_KEY=replace_with_your_stripe_publishable_key
BREVO_API_KEY=replace_with_your_brevo_api_key_in_netlify
BREVO_LIST_ID=replace_with_your_brevo_list_id_in_netlify
PORT=4242
